# application.properties.example
spring.application.name=Quiz-Service

spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.url=jdbc:postgresql://localhost:5432/QuizApplicationQuizDB
spring.datasource.username = your-username
spring.datasource.password= your-password
#Becuse we are using default fort 8080 for question service
server.port=8090

spring.jpa.hibernate.ddl-auto=update
spring.jpa.property.hibernate.dialect=org.hibernate.dialect.PostgresSQLDialect

#should be same as apigateway secret
gateway.secret = your-secret-code

spring.boot.admin.client.enabled=true
management.endpoint.health.show-details=always